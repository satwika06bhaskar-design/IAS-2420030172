{
  "name": "securetunnel-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File ./run.ps1",
    "backend": "cd backend && venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "frontend": "cd frontend && npm run dev",
    "test:backend": "cd backend && venv\\Scripts\\pytest -v tests",
    "test:frontend": "cd frontend && npm test",
    "test": "npm run test:backend && npm run test:frontend"
  }
}
